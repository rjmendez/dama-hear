// Copy to secrets.h and fill in. secrets.h is gitignored -- do not commit credentials.
// Without it the node starts its own access point instead (SSID below), which works but means
// walking out to it. For an unattended run you want STA.
#pragma once
#define WIFI_SSID "your-ssid"
#define WIFI_PASS "your-password"

// Per-device token privileged endpoints require (Alert 1): /update, /reboot, /format, /gate
// writes, and the hardware-sweep probes all send 401 without X-Hear-Auth: <token> or
// ?token=<token> matching this. Never the same value across the fleet -- gen_secrets.py can mint
// one per node from a local, gitignored source the same way it already does for HEAR_PUSH_TOKEN.
// Leaving this at "" (the built-in default) means those endpoints refuse EVERY request, which is
// the fail-closed behaviour HEAR_REQUIRE_ADMIN_AUTH is for.
// #define HEAR_ADMIN_TOKEN "replace-with-a-long-random-per-node-token"

// This node's own fallback-AP password (Alert 5). Set by enroll.py's NVS provisioning in normal
// use; a compiled override here is only for a build that cannot go through enroll.py. Leaving it
// unset does NOT bring back the old shared "damahear" -- see ap_password() in hear_node.ino.
// #define AP_PASS_OVERRIDE "a-per-node-ap-password"

// Root CA for HEAR_PUSH_HOST's TLS certificate (Alert 3). The built-in default (Amazon Root CA 1,
// in hear_push_ca.h) matches the compiled-in api.botnet.floppydicks.net host; override this ONLY
// for a HEAR_PUSH_HOST pointed at a different backend with a different CA.
// #define HEAR_PUSH_CA_CERT "-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n"

# hear-runtime -- the interpreter, and deliberately nothing else.
#
# ⚠️A SERVICE IMAGE IS BUILT ON THIS ONE; A WORKER IS NOT BUILT HERE. This layer carries no
# application code, no model weights and no third-party package, so it is shared by every worker
# and rebuilt only when the base digest or the OS packages move. What each worker needs goes in
# that worker's own image (deploy/images/service/, added by the first pilot), from its own lock.
#
# FROM is a digest, not a tag: see deploy/images/base-images.txt.
FROM python@sha256:9d2e5553305c7c7b0097999bb17187c69b921ccd6bc9d40e4bb5ebe652c00285
# The tag that digest was published under, for `docker inspect` and for humans reading history.
LABEL org.opencontainers.image.base.name="docker.io/library/python:3.13-slim"
LABEL org.opencontainers.image.base.digest="sha256:9d2e5553305c7c7b0097999bb17187c69b921ccd6bc9d40e4bb5ebe652c00285"
LABEL org.opencontainers.image.source="https://github.com/rjmendez/dama-hear"
LABEL org.opencontainers.image.title="hear-runtime"
LABEL org.opencontainers.image.description="Python 3.13 base for dama-hear workers: no packages, no code, no weights."
LABEL org.opencontainers.image.licenses="MIT"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ONLY_BINARY=:all: \
    PYTHONPATH=/app

# ⚠️THE SAME THREAD CAPS THE CI MATRIX SETS. An unbounded BLAS in a 1-CPU-limit container is how
# a solve that passes in CI takes minutes in the cluster; the numeric variant inherits these.
ENV OPENBLAS_NUM_THREADS=1 \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1

# ⚠️SECURITY UPGRADES ONLY, AND NEVER AN INSTALL. The pinned base carries whatever Debian
# packages it was built with, and it is republished on its own schedule -- the first scan of
# this chain found 12 fixable HIGH/CRITICAL CVEs (perl, gzip, pcre2, sqlite3) that Debian had
# already fixed and the base had not yet picked up. A digest pin freezes the fix out as
# effectively as it freezes the bug in, so the OS layer tracks security while the Python closure
# stays locked. `upgrade`, not `install`: nothing new enters the image here.
RUN set -eux; \
    apt-get update; \
    apt-get upgrade -y --no-install-recommends; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

# uid 65532 is nonroot by the distroless convention, and it is a FIXED number on purpose: the
# hear-pool PVC already has files on it owned by the uid the current pods write as, so the
# migration has one number to reconcile rather than one per rebuild.
RUN set -eux; \
    groupadd --gid 65532 hear; \
    useradd --uid 65532 --gid 65532 --home-dir /app --no-create-home --shell /usr/sbin/nologin hear; \
    mkdir -p /app; \
    chown 65532:65532 /app

WORKDIR /app
USER 65532:65532
